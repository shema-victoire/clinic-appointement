# ===== Clinic Appointment & Prescription System: environment variables =====
# NEVER commit this file. Only .env.example goes to GitHub.

# ----- Supabase (PostgreSQL + Auth) -----
SUPABASE_URL=
# Project Settings > API
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (URI). Replace [YOUR-PASSWORD] with your DB password.
# If the password has special characters (@ : / ? # %), URL-encode them.
DATABASE_URL=

# ----- Google OAuth (already connected inside Supabase, kept for reference) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- MongoDB Atlas (consultation notes) -----
MONGODB_URI=

# ----- RabbitMQ on CloudAMQP (notifications) -----
# CloudAMQP instance page > AMQP details > copy the full URL and paste it over this line,
# or just replace YOUR_AMQP_PASSWORD with the instance password.
AMQP_URL=

# ----- Email (fill in once you choose Gmail SMTP or Resend) -----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ----- App -----
PORT=
FRONTEND_URL=

# ----- Frontend (Vite reads these; copy into the frontend folder's own .env if the project is split) -----
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
