# ===== Clinic Appointment & Prescription System – environment variables =====
# Copy this file to .env and fill in your values. NEVER commit .env.

# ----- Supabase (PostgreSQL + Auth) -----
# Project Settings > API > Project URL
SUPABASE_URL=

# Project Settings > API > anon/public key
SUPABASE_ANON_KEY=

# Project Settings > API > service_role key (keep secret – backend only)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string (URI mode)
# Replace [YOUR-PASSWORD] with your DB password. URL-encode special chars (@ : / ? # %).
DATABASE_URL=

# ----- Google OAuth (configured inside Supabase Dashboard > Auth > Providers) -----
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- MongoDB Atlas (stores consultation notes) -----
# Atlas > Connect > Drivers > connection string
MONGODB_URI=

# ----- RabbitMQ / CloudAMQP (appointment event queue) -----
# CloudAMQP instance page > AMQP details > full URL
AMQP_URL=

# ----- SMTP / Email (appointment-confirmed notifications) -----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ----- App -----
# Port the Express server listens on (default 5000)
PORT=
# Full origin of the frontend, used for CORS (e.g. http://localhost:5173)
FRONTEND_URL=

# ----- Frontend – Vite reads VITE_* vars at build time -----
# Full URL of the Express API (e.g. http://localhost:5000)
VITE_API_URL=
# Supabase project URL (same value as SUPABASE_URL above)
VITE_SUPABASE_URL=
# Supabase anon/public key (same value as SUPABASE_ANON_KEY above)
VITE_SUPABASE_ANON_KEY=
